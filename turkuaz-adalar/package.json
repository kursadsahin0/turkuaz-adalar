{
  "name": "turkuaz-adalar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "validate:character": "node scripts/validate-character-glb.mjs",
    "validate:assets": "node scripts/validate-asset-pipeline.mjs",
    "validate:camera": "node scripts/validate-camera-system.mjs",
    "validate:movement": "node scripts/validate-movement-system.mjs",
    "validate:advanced": "node scripts/validate-advanced-movement.mjs",
    "validate:collectibles": "node scripts/validate-collectibles.mjs",
    "validate:levels": "node scripts/validate-levels.mjs",
    "validate:characters": "node scripts/validate-characters.mjs",
    "validate:save": "node scripts/validate-save-system.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "validate:monetization": "node scripts/validate-monetization.mjs",
    "test:meta": "node scripts/test-meta-systems.mjs",
    "test:save": "node scripts/test-save-functionality.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:keystore": "bash scripts/create-upload-key.sh",
    "android:release": "node scripts/check-release-config.mjs android && npm run android:sync && cd android && ./gradlew bundleRelease",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/sync-ios-version.mjs && node scripts/sync-ios-admob.mjs",
    "ios:release": "node scripts/check-release-config.mjs ios && npm run ios:sync",
    "release:check": "node scripts/check-release-config.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\" \"public/*.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"*.{ts,json,md}\" \"public/*.html\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "assets:brand": "node scripts/generate-brand-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#062c36' --iconBackgroundColorDark '#041a20' --splashBackgroundColor '#062c36' --splashBackgroundColorDark '#041a20'",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "playtest": "node scripts/playtest-bot.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@types/three": "^0.186.0",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@sentry/browser": "^10.78.0",
    "three": "^0.187.0"
  }
}
