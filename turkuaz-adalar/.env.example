# Copy to .env.production.local (git-ignored) and fill in your own values.
# Only production builds (npm run build, android:*, ios:*) read that file;
# `npm run dev` always uses Google's test ads. See RELEASE.md.

# AdMob → Apps → (app) → App settings. Format ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=

# AdMob → Apps → (app) → Ad units → the Rewarded unit. Format ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=

# Optional: Sentry crash reports (only sent when the player allows them).
VITE_SENTRY_DSN=

# Optional: anonymous usage analytics (where players stop: funnels, retention).
# Create a free PostHog Cloud project (EU region) → Project settings → Project API key.
# Only sent when the player allows it (Settings → Privacy).
VITE_ANALYTICS_KEY=
VITE_ANALYTICS_HOST=https://eu.i.posthog.com
