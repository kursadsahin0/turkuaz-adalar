<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. Only the game's save (WebView localStorage:
  progress, coins, cosmetics, settings) is backed up and moved to a new phone.
  Caches, crash logs, the WebView's HTTP cache and ad SDK data stay on the
  device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
